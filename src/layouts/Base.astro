---
import '../styles/global.css';
import { site, nav, footer, home } from '../data/content.ts';
const { title = site.name + ' - ' + site.tagline, description = site.description, finalCtaImage = '/portret-dylan.jpg', finalCtaImageAlt = 'Dylan van den Bosch, oprichter van Biite' } = Astro.props;
const canonical = `https://astro.woodwolfdigital.com${Astro.url.pathname}`;
const ogImage = 'https://astro.woodwolfdigital.com/og.jpg';
const checkItems = [
  'Je bespreekt je vraag met iemand die ook bij de uitvoering betrokken blijft.',
  'Samen met Biite bekijk je wat nodig is en welke eerste stap past.',
  'Past je vraag beter bij een andere specialist, dan hoor je dat.',
];
const checkSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="cta-check"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg>';
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="nl_NL" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#fffef7" />
</head>
<body>
<header class="site"><div class="wrap"><div class="header-inner">
<a href="/" aria-label="Biite, naar de homepage"><img src="/logo.svg" alt="Biite" style="height:26px;width:auto;display:block" /></a>
<nav class="main" aria-label="hoofdnavigatie">{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
<a href={site.ctaHref} class="btn" style="margin-left:auto">{site.ctaLabel} &rarr;</a>
<button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="menu openen" onclick="document.getElementById('mobile-menu').classList.toggle('open');this.setAttribute('aria-expanded', document.getElementById('mobile-menu').classList.contains('open') ? 'true' : 'false')"><span></span><span></span><span></span></button>
</div><nav id="mobile-menu" class="mobile-menu" aria-label="mobiele navigatie">{nav.map(n => <a href={n.href}>{n.label}</a>)}<a href="/blog/">Blog</a><a href="/contact/">Contact</a></nav></div></header>
<main><slot /></main>
<footer>
  <section class="final-cta-section"><div class="wrap"><div class="final-cta-grid">
    <div class="final-cta-card">
      <h2 class="kop-sectie">Laten we <strong class="text-vivid">samen</strong> kijken waar groei vastloopt</h2>
      <ul class="final-cta-checklist">
        {checkItems.map(t => <li><span set:html={checkSvg} />{t}</li>)}
      </ul>
      <div class="hero-actions"><a class="btn" style="background:#FF4D5A" href={site.ctaHref}>{site.ctaLabel} &rarr;</a><a class="textlink" href="/expertise/">{home.finalCtaSecondaryLabel}</a></div>
    </div>
    <div class="final-cta-img"><img src={finalCtaImage} alt={finalCtaImageAlt} width="1122" height="1402" loading="lazy" decoding="async" /></div>
  </div></div></section>
  <div class="voet-reveal"><div class="voet-reveal__vlak bg-raised"><div class="wrap"><div class="footer-grid-light">
    <div>
      <img src="/logo.svg" alt="Biite" style="height:32px;width:auto;display:block" />
      <p style="margin-top:20px;max-width:34ch;font-size:14px;line-height:1.7;color:var(--muted)">{footer.intro}</p>
      <a href={site.linkedin} class="linkedin-btn" aria-label="Biite op LinkedIn"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M216,20H40A20,20,0,0,0,20,40V216a20,20,0,0,0,20,20H216a20,20,0,0,0,20-20V40A20,20,0,0,0,216,20Zm-4,192H44V44H212ZM112,176V120a12,12,0,0,1,21.43-7.41A40,40,0,0,1,192,148v28a12,12,0,0,1-24,0V148a16,16,0,0,0-32,0v28a12,12,0,0,1-24,0ZM96,120v56a12,12,0,0,1-24,0V120a12,12,0,0,1,24,0ZM68,80A16,16,0,1,1,84,96,16,16,0,0,1,68,80Z"></path></svg></a>
    </div>
    <nav aria-label="footernavigatie"><p class="footer-col-title">{footer.navTitle}</p><ul class="footer-links">{footer.navLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
    <nav aria-label="expertise"><p class="footer-col-title">{footer.expertiseTitle}</p><ul class="footer-links">{footer.expertiseLinks.map(l => <li><a href={l.href}><span class="footer-num">{l.n}</span>{l.label}</a></li>)}</ul></nav>
    <div><p class="footer-col-title">{footer.contactTitle}</p><ul class="footer-links"><li><a href={`mailto:${site.email}`}>{site.email}</a></li><li><a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a></li></ul></div>
  </div>
  <div class="footer-bottom-light"><p>2026 Biite<span> &middot; KvK 42153735</span><span> &middot; btw NL005540062B37</span></p><div>{footer.legal.map(l => <a href={l.href}>{l.label}</a>)}</div></div>
  </div></div></div>
</footer>
</body></html>

---
import '../styles/global.css';
import { site, nav, footer, home } from '../data/content.ts';
const { title = site.name + ' - ' + site.tagline, description = site.description } = Astro.props;
const canonical = `https://astro.woodwolfdigital.com${Astro.url.pathname}`;
const ogImage = 'https://astro.woodwolfdigital.com/og.jpg';
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="nl_NL" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#fffef7" />
</head>
<body>
<header class="site"><div class="wrap"><div class="header-inner">
<a href="/" aria-label="Biite, naar de homepage"><img src="/logo.svg" alt="Biite" style="height:26px;width:auto;display:block" /></a>
<nav class="main" aria-label="hoofdnavigatie">{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
<a href={site.ctaHref} class="btn" style="margin-left:auto">{site.ctaLabel} &rarr;</a>
</div></div></header>
<main><slot /></main>
<section class="final-cta"><div class="wrap"><h2>{home.finalCtaTitle}</h2><p class="lead" style="max-width:62ch">{home.finalCtaBody}</p><div class="hero-actions"><a class="btn" href={site.ctaHref}>{site.ctaLabel} &rarr;</a><a class="textlink" href={home.finalCtaSecondaryHref}>{home.finalCtaSecondaryLabel}</a></div></div></section>
<footer><div class="wrap"><div class="footer-grid">
<div><img src="/logo.svg" alt="Biite" style="height:28px;width:auto;display:block;filter:invert(1)" /><p style="color:rgba(255,255,255,.72);max-width:38ch;margin-top:16px">{footer.intro}</p></div>
<div><b>{footer.navTitle}</b><ul style="list-style:none;padding:0;display:grid;gap:8px;margin-top:14px">{footer.navLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
<div><b>{footer.expertiseTitle}</b><ul style="list-style:none;padding:0;display:grid;gap:8px;margin-top:14px">{footer.expertiseLinks.map(l => <li><a href={l.href}>{l.n} {l.label}</a></li>)}</ul></div>
<div><b>{footer.contactTitle}</b><ul style="list-style:none;padding:0;display:grid;gap:8px;margin-top:14px"><li><a href={`mailto:${site.email}`}>{site.email}</a></li><li><a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a></li><li><a href={site.linkedin}>LinkedIn</a></li></ul></div>
</div><div class="footer-bottom"><span>{footer.legalLine}</span><span>{footer.legal.map(l => <a href={l.href} style="margin-left:14px">{l.label}</a>)}</span></div></div></footer>
</body></html>

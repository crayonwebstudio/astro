---
import '../styles/global.css';
import { site, nav, footer, home, megaMenu } from '../data/content.ts';
const { title = site.name + ' · ' + site.tagline, description = site.description, ogDescription = description, jsonLd = [], finalCtaImage = '/portret-dylan.jpg', finalCtaImageAlt = 'At work on an ecommerce project' } = Astro.props;
const siteUrl = 'https://astro.woodwolfdigital.com';
const canonical = `${siteUrl}${Astro.url.pathname}`;
const ogImage = `${siteUrl}/og.jpg`;
const jsonLdGraph = [
  { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Omnimerce', url: `${siteUrl}/`, slogan: 'Commerce Without Complexity', description: 'Omnimerce connects the systems, processes and technology behind ecommerce businesses. From ERP and manufacturing to marketplace integrations, AI-powered product content and digital growth, we help businesses reduce manual work and operate with greater clarity.', email: site.email, logo: { '@type': 'ImageObject', '@id': `${siteUrl}/#logo`, url: `${siteUrl}/omnimerce-logo.svg`, contentUrl: `${siteUrl}/omnimerce-logo.svg`, caption: 'Omnimerce' }, image: { '@id': `${siteUrl}/#logo` }, contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: site.email, availableLanguage: 'en' } },
  { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: `${siteUrl}/`, name: 'Omnimerce', alternateName: 'omnimerce.online', inLanguage: 'en', publisher: { '@id': `${siteUrl}/#organization` } },
  ...jsonLd,
];
const checkItems = [
  'Tell us about your business: your systems, sales channels and the problem you want to solve.',
  'We discuss your requirements: the questions, constraints and possible approaches.',
  'We define a practical next step, and if another specialist fits better, you will hear that.',
];
const checkSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="cta-check"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg>';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLdGraph })} />
<link rel="icon" href="/omnimerce-icon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#FAF8F5" />
</head>
<body>
<header class="site"><div class="wrap"><div class="header-inner">
<a href="/" aria-label="Omnimerce, back to homepage"><svg class="site-logo" xmlns="http://www.w3.org/2000/svg" viewBox="40 112 876 176" role="img" aria-label="Omnimerce" style="width:auto"><path d="M136.246 185.335 C149.266 201.063 149.901 223.636 137.785 240.07 C125.67 256.505 103.919 262.575 85.044 254.79 C66.169 247.005 55.022 227.366 58.016 207.169 C61.009 186.972 77.373 171.41 97.694 169.434" fill="none" stroke="#333333" stroke-width="24"/><path d="M126.334 129.677 C128.163 148.45 132.207 154.645 150.776 160.301 C131.926 164.936 127.551 170.901 124.702 189.547 C122.873 170.774 118.83 164.579 100.26 158.924 C119.11 154.289 123.485 148.323 126.334 129.677 Z" fill="#ff795b"/><text transform="matrix(1.02 0 0 1 157.592 269.018)" x="0" y="0" xml:space="preserve" font-family="'Plus Jakarta Sans'" font-size="163.812" font-weight="800" fill="#333333" letter-spacing="-11.139"><tspan x="0" y="0">mnimerce</tspan></text></svg></a>
<nav class="main" aria-label="Main navigation">{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
</div></div></header>
<div class="header-actions">
<a href={site.ctaHref} class="btn header-cta">{site.ctaLabel} &rarr;</a>
<button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="mega-menu" aria-label="Open menu"><svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="5" width="18" height="2" rx="1"></rect><rect x="3" y="11" width="18" height="2" rx="1"></rect><rect x="3" y="17" width="18" height="2" rx="1"></rect></svg><svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5 L19 19 M19 5 L5 19"></path></svg></button>
</div>
<div id="mega-backdrop" class="mega-backdrop"></div>
<nav id="mega-menu" class="mega-menu" aria-label="Menu"><div class="mega-grid">{megaMenu.columns.map(col => <div class="mega-col"><h3>{col.title}</h3><ul>{col.links.map(l => <li><a href={l.href}>{col.numbered && <span class="mega-num">{l.number}</span>}<span>{l.label}</span></a></li>)}</ul></div>)}</div></nav>
<script>
(function(){ var btn=document.getElementById('menu-btn'), menu=document.getElementById('mega-menu'), bd=document.getElementById('mega-backdrop'); if(!btn||!menu||!bd) return; function setOpen(o){ menu.classList.toggle('open',o); bd.classList.toggle('open',o); btn.classList.toggle('menu-open',o); btn.setAttribute('aria-expanded', o?'true':'false'); btn.setAttribute('aria-label', o?'Close menu':'Open menu'); } btn.addEventListener('click', function(){ setOpen(!menu.classList.contains('open')); }); bd.addEventListener('click', function(){ setOpen(false); }); menu.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){ setOpen(false); }); }); document.addEventListener('keydown', function(e){ if(e.key==='Escape') setOpen(false); }); })();
</script>
<main><slot /></main>
<footer>
  <section class="final-cta-section"><div class="wrap"><div class="final-cta-grid">
    <div class="final-cta-card">
      <h2 class="kop-sectie">Let's make your ecommerce operations <strong class="text-vivid">simpler</strong>.</h2>
      <ul class="final-cta-checklist">
        {checkItems.map(t => <li><span set:html={checkSvg} />{t}</li>)}
      </ul>
      <div class="final-cta-actions"><a class="btn" href={site.ctaHref}>{site.ctaLabel} &rarr;</a><a class="textlink" href={home.finalCtaSecondaryHref}>{home.finalCtaSecondaryLabel}</a></div>
    </div>
    <div class="final-cta-img"><img src={finalCtaImage} alt={finalCtaImageAlt} width="1122" height="1402" loading="lazy" decoding="async" /></div>
  </div></div></section>
  <div class="voet-reveal"><div class="voet-reveal__vlak bg-raised"><div class="wrap"><div class="footer-grid-light">
    <div>
      <svg class="footer-logo" xmlns="http://www.w3.org/2000/svg" viewBox="40 112 876 176" role="img" aria-label="Omnimerce" style="height:40px;width:auto;display:block"><path d="M136.246 185.335 C149.266 201.063 149.901 223.636 137.785 240.07 C125.67 256.505 103.919 262.575 85.044 254.79 C66.169 247.005 55.022 227.366 58.016 207.169 C61.009 186.972 77.373 171.41 97.694 169.434" fill="none" stroke="#333333" stroke-width="24"/><path d="M126.334 129.677 C128.163 148.45 132.207 154.645 150.776 160.301 C131.926 164.936 127.551 170.901 124.702 189.547 C122.873 170.774 118.83 164.579 100.26 158.924 C119.11 154.289 123.485 148.323 126.334 129.677 Z" fill="#ff795b"/><text transform="matrix(1.02 0 0 1 157.592 269.018)" x="0" y="0" xml:space="preserve" font-family="'Plus Jakarta Sans'" font-size="163.812" font-weight="800" fill="#333333" letter-spacing="-11.139"><tspan x="0" y="0">mnimerce</tspan></text></svg>
      <p style="margin-top:20px;max-width:34ch;font-size:14px;line-height:1.7;color:var(--muted)">{footer.intro}</p>
    </div>
    <nav aria-label="Footer navigation"><p class="footer-col-title">{footer.navTitle}</p><ul class="footer-links">{footer.navLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
    <nav aria-label="Solutions"><p class="footer-col-title">{footer.expertiseTitle}</p><ul class="footer-links">{footer.expertiseLinks.map(l => <li><a href={l.href}><span class="footer-num">{l.n}</span>{l.label}</a></li>)}</ul></nav>
    <div><p class="footer-col-title">{footer.contactTitle}</p><ul class="footer-links"><li><a href={`mailto:${site.email}`} style="display:inline-flex;align-items:baseline;gap:8px"><svg class="footer-contact-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M224,44H32A12,12,0,0,0,20,56V192a20,20,0,0,0,20,20H216a20,20,0,0,0,20-20V56A12,12,0,0,0,224,44ZM193.15,68,128,127.72,62.85,68ZM44,188V83.28l75.89,69.57a12,12,0,0,0,16.22,0L212,83.28V188Z"></path></svg>{site.email}</a></li></ul></div>
  </div>
  <div class="footer-bottom-light"><p>{footer.legalLine}</p><div>{footer.legal.map(l => <a href={l.href}>{l.label}</a>)}</div></div>
  </div></div></div>
</footer>
</body></html>

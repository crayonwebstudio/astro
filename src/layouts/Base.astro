---
import '../styles/global.css';
import { site, nav, SITE_URL } from '../data/omnimerce.ts';
const { title = site.name + ' | ' + site.positioning, description = site.description, ogDescription = description, jsonLd = [] } = Astro.props;
const siteUrl = SITE_URL;
const canonical = `${siteUrl}${Astro.url.pathname}`;
const ogImage = `${siteUrl}/og.jpg`;
const jsonLdGraph = [
  { '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Omnimerce', url: `${siteUrl}/`, slogan: 'Commerce Without Complexity', description: 'Omnimerce connects the systems, processes and technology behind ecommerce businesses. From ERP and manufacturing to marketplace integrations, AI-powered product content and digital growth, we help businesses reduce manual work and operate with greater clarity.', email: site.email, logo: { '@type': 'ImageObject', '@id': `${siteUrl}/#logo`, url: `${siteUrl}/omnimerce-logo.svg`, contentUrl: `${siteUrl}/omnimerce-logo.svg`, caption: 'Omnimerce' }, image: { '@id': `${siteUrl}/#logo` }, contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: site.email, availableLanguage: 'en' } },
  { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: `${siteUrl}/`, name: 'Omnimerce', alternateName: 'omnimerce.online', inLanguage: 'en', publisher: { '@id': `${siteUrl}/#organization` } },
  ...jsonLd,
];
const solutionLinks = [
  { label: 'ERP & Accounting', href: '/solutions/ecommerce-erp-accounting/' },
  { label: 'Manufacturing & Inventory', href: '/solutions/manufacturing-inventory/' },
  { label: 'Marketplace Integrations', href: '/solutions/marketplace-integration/' },
  { label: 'AI Product Content', href: '/solutions/ai-product-content/' },
  { label: 'Marketing Automation', href: '/solutions/marketing-automation/' },
  { label: 'Ecommerce SEO', href: '/solutions/ecommerce-seo/' },
  { label: 'Custom Integrations', href: '/solutions/custom-integrations/' },
];
const companyLinks = [
  { label: 'About Omnimerce', href: '/about/' },
  { label: 'Our Approach', href: '/our-approach/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Case Studies', href: '/case-studies/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'Contact', href: '/contact/' },
];
const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms & Conditions', href: '/terms/' },
  { label: 'FAQ', href: '/faq/' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLdGraph })} />
<link rel="icon" href="/omnimerce-icon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#FAF8F5" />
</head>
<body>
<header class="site"><div class="wrap"><div class="header-inner">
<a href="/" aria-label="Omnimerce, back to homepage"><svg class="site-logo" xmlns="http://www.w3.org/2000/svg" viewBox="40 112 876 176" role="img" aria-label="Omnimerce" style="width:auto"><path d="M136.246 185.335 C149.266 201.063 149.901 223.636 137.785 240.07 C125.67 256.505 103.919 262.575 85.044 254.79 C66.169 247.005 55.022 227.366 58.016 207.169 C61.009 186.972 77.373 171.41 97.694 169.434" fill="none" stroke="#333333" stroke-width="24"/><path d="M126.334 129.677 C128.163 148.45 132.207 154.645 150.776 160.301 C131.926 164.936 127.551 170.901 124.702 189.547 C122.873 170.774 118.83 164.579 100.26 158.924 C119.11 154.289 123.485 148.323 126.334 129.677 Z" fill="#ff795b"/><text transform="matrix(1.02 0 0 1 157.592 269.018)" x="0" y="0" xml:space="preserve" font-family="'Plus Jakarta Sans'" font-size="163.812" font-weight="800" fill="#333333" letter-spacing="-11.139"><tspan x="0" y="0">mnimerce</tspan></text></svg></a>
<nav class="main" aria-label="Main navigation">{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
</div></div></header>
<div class="header-actions">
<a href={site.ctaHref} class="btn header-cta">{site.ctaLabel} &rarr;</a>
<button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" onclick="document.getElementById('mobile-menu').classList.toggle('open');this.setAttribute('aria-expanded', document.getElementById('mobile-menu').classList.contains('open') ? 'true' : 'false')"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="5" width="18" height="2" rx="1"></rect><rect x="3" y="11" width="18" height="2" rx="1"></rect><rect x="3" y="17" width="18" height="2" rx="1"></rect></svg></button>
</div>
<nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation">{nav.map(n => <a href={n.href} onclick="document.getElementById('mobile-menu').classList.remove('open')">{n.label}</a>)}</nav>
<main><slot /></main>
<footer>
  <div class="voet-reveal"><div class="voet-reveal__vlak bg-raised"><div class="wrap"><div class="footer-grid-light">
    <div>
      <svg class="footer-logo" xmlns="http://www.w3.org/2000/svg" viewBox="40 112 876 176" role="img" aria-label="Omnimerce" style="height:40px;width:auto;display:block"><path d="M136.246 185.335 C149.266 201.063 149.901 223.636 137.785 240.07 C125.67 256.505 103.919 262.575 85.044 254.79 C66.169 247.005 55.022 227.366 58.016 207.169 C61.009 186.972 77.373 171.41 97.694 169.434" fill="none" stroke="#333333" stroke-width="24"/><path d="M126.334 129.677 C128.163 148.45 132.207 154.645 150.776 160.301 C131.926 164.936 127.551 170.901 124.702 189.547 C122.873 170.774 118.83 164.579 100.26 158.924 C119.11 154.289 123.485 148.323 126.334 129.677 Z" fill="#ff795b"/><text transform="matrix(1.02 0 0 1 157.592 269.018)" x="0" y="0" xml:space="preserve" font-family="'Plus Jakarta Sans'" font-size="163.812" font-weight="800" fill="#333333" letter-spacing="-11.139"><tspan x="0" y="0">mnimerce</tspan></text></svg>
      <p style="margin-top:20px;font-weight:700;color:var(--deep)">Commerce Without Complexity.</p>
      <p style="margin-top:8px;max-width:36ch;font-size:14px;line-height:1.7;color:var(--muted)">AI-powered ecommerce solutions that connect business operations, marketplace integrations and intelligent automation.</p>
    </div>
    <nav aria-label="Solutions"><p class="footer-col-title">Solutions</p><ul class="footer-links">{solutionLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
    <nav aria-label="Company"><p class="footer-col-title">Company</p><ul class="footer-links">{companyLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
    <div><p class="footer-col-title">Contact</p><ul class="footer-links"><li><a href={`mailto:${site.email}`}>{site.email}</a></li></ul>
    <p class="footer-col-title" style="margin-top:28px">Legal</p><ul class="footer-links">{legalLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
  </div>
  <div class="footer-bottom-light"><p>Copyright &copy; 2026 Omnimerce. All rights reserved.</p><div>{legalLinks.slice(0,2).map(l => <a href={l.href}>{l.label}</a>)}</div></div>
  </div></div></div>
</footer>
</body></html>

---
<section id="omnimerce-hero" class="omnimerce-hero">
  <svg id="wireCanvas" class="wire-canvas" aria-hidden="true"><defs><linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#2563eb" stop-opacity="0.22"/><stop offset="100%" stop-color="#2563eb" stop-opacity="0.01"/></linearGradient></defs><g id="baseWires"></g><g id="cardWireG"></g><g id="activeWireG"></g></svg>
  <div class="hero-inner"><div class="hero-grid">
    <div class="hero-copy">
      <h1 class="remix-kop"><span class="remix-kop-line">Commerce Without</span><span class="remix-kop-line2">Complexity<span id="hart" class="hart"><span class="hart-dot"></span><span class="hart-ring"></span></span></span></h1>
      <p class="remix-lead">Omnimerce brings ERP, manufacturing, inventory, marketplaces and AI-powered automation together through solutions designed around how your business actually works. From business processes and system integrations to AI-powered growth, we help you build a more connected ecommerce operation.</p>
      <div class="remix-ctas"><a href="/contact/" class="remix-btn-primary">Discuss Your Project <span aria-hidden="true">→</span></a><a href="/solutions/" class="remix-textlink">Explore Our Solutions</a></div>
    </div>
    <div id="treeRef" class="tree-ref">
      {nodes.map((n, nodeIndex) => (<div class="remix-node" data-id={n.id} data-side={n.side} style={`top:${n.top}%;left:${n.left}%;transform:${n.side === 'L' ? 'translate(-100%, -50%)' : 'translate(0%, -50%)'};--blink:${(1.8 + (nodeIndex * 0.35) % 1.4).toFixed(2)}s;--blink-delay:-${((nodeIndex * 0.45) % 1.8).toFixed(2)}s`} role="button" tabindex="0" aria-label={`${n.label} (${n.phaseName})`}><span class="remix-node-logo" set:html={logos[n.logo]} /><span class="remix-node-label">{n.label}</span><div class="remix-tooltip"><div class="remix-tooltip-head"><span class="remix-tooltip-nr">{n.phaseNr}</span><span>{n.phaseName}</span></div><p class="remix-tooltip-desc">{n.description}</p></div></div>))}
      <div id="meterCard" class="meter-card"><div class="meter-check" title="System verified and connected">✓</div><div class="meter-tabs"><button type="button" class="meter-tab active" data-metric="leads"><span class="meter-tab-label">Leads</span><span class="meter-tab-value">417</span></button><button type="button" class="meter-tab" data-metric="verkeer"><span class="meter-tab-label">Traffic</span><span class="meter-tab-value">17,758</span></button><button type="button" class="meter-tab" data-metric="conversie"><span class="meter-tab-label">Conversion</span><span class="meter-tab-value">2.3%</span></button></div><div class="meter-chart-wrap"><svg class="meter-chart" viewBox="0 0 272 64" preserveAspectRatio="none" aria-hidden="true"><line x1="8" y1="12" x2="264" y2="12" stroke="#e5e7eb" stroke-width="0.75" /><line x1="8" y1="34" x2="264" y2="34" stroke="#e5e7eb" stroke-width="0.75" /><line x1="8" y1="52" x2="264" y2="52" stroke="#e5e7eb" stroke-width="0.75" /><path id="chartArea" fill="url(#chartFill)" /><path id="chartPrev" fill="none" stroke="#94a3b8" stroke-width="1.25" stroke-dasharray="3 3" /><path id="chartCurr" fill="none" stroke="#2563eb" stroke-width="1.75" stroke-linecap="round" /><circle cx="218" cy="18" r="3" fill="#2563eb" /><circle cx="218" cy="18" r="5" fill="none" stroke="#2563eb" stroke-opacity="0.4" /><g id="chartHoverG" style="display:none"><line id="chartHoverLine" y1="6" y2="52" stroke="#2563eb" stroke-width="1" stroke-dasharray="2 2" /><circle id="chartHoverDot" r="4" fill="#2563eb" stroke="#ffffff" stroke-width="1.5" /></g></svg><div class="meter-hover-cols" id="meterHoverCols"></div><div class="meter-y"><span>40</span><span>20</span><span>0</span></div></div><div class="meter-dates"><span>22 Sep</span><span>29</span><span>06 Oct</span><span>13</span></div><div class="meter-legend"><span><i class="legend-line"></i>Last 28 days</span><span><i class="legend-dash"></i>Previous period</span></div><div class="groei-wrap"><span class="groei-text">Growth that lasts</span><svg class="groei-arrow" viewBox="0 0 90 60" fill="none"><path d="M 75 4 C 82 28, 54 48, 12 47" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M 22 39 L 12 47 L 24 53" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div></div>
    </div>
  </div></div>
</section>
<style>
.omnimerce-hero{position:relative;min-height:92vh;width:100%;overflow:hidden;background:#FAF8F5;padding:92px 24px 80px;background-image:radial-gradient(circle at 75% 40%, rgba(255,121,91,0.02) 0%, transparent 60%)}
.wire-canvas{pointer-events:none;position:absolute;inset:0;z-index:0;width:100%;height:100%;overflow:visible}
.hero-inner{position:relative;z-index:10;margin:0 auto;max-width:1600px}
.hero-grid{display:grid;grid-template-columns:1fr;gap:40px;align-items:start}
@media(min-width:1024px){.hero-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:48px}}
@media(min-width:1280px){.hero-grid{gap:64px}}
.hero-copy{align-self:start;padding-top:0}
@media(min-width:1024px){.hero-copy{align-self:center;transform:translateY(32px);padding-left:16px}}
@media(min-width:1600px){.hero-copy{padding-left:calc(16px + (100vw - 1600px) / 2)}}
@media(min-width:1648px){.hero-copy{padding-left:40px}}
.remix-kop{font-size:36px;font-weight:800;letter-spacing:-0.04em;color:#242424;line-height:1.02;margin:0}
@media(min-width:640px){.remix-kop{font-size:48px}}
@media(min-width:768px){.remix-kop{font-size:52px}}
@media(min-width:1024px){.remix-kop{font-size:68px}}
@media(min-width:1280px){.remix-kop{font-size:72px}}
.remix-kop-line{display:block}
.remix-kop-line2{position:relative;margin-top:4px;display:inline-flex;align-items:baseline;white-space:nowrap}
.hart{position:relative;margin-left:6px;display:inline-flex;width:14px;height:14px;cursor:pointer;align-items:center;justify-content:center;transform:translateY(2px)}
.hart-dot{position:absolute;display:inline-block;width:14px;height:14px;border-radius:50%;background:#FF795B;box-shadow:0 1px 2px rgba(255,121,91,0.5)}
.hart-ring{position:absolute;width:20px;height:20px;border-radius:50%;border:2px solid #FF795B;opacity:0}
.hart.pulse-on .hart-ring{animation:pulse-ring 2s cubic-bezier(0.19,1,0.22,1) infinite;opacity:1}
@keyframes pulse-ring{0%{transform:scale(0.9);opacity:0.85}40%{opacity:0.55}85%{opacity:0.1}100%{transform:scale(2.8);opacity:0}}
@keyframes pulse-signal{0%{stroke-dashoffset:600}100%{stroke-dashoffset:0}}
.remix-lead{margin-top:28px;max-width:29rem;font-size:16px;line-height:1.65;color:rgba(36,36,36,0.75)}
@media(min-width:640px){.remix-lead{font-size:18px}}
.remix-ctas{margin-top:36px;display:flex;flex-wrap:wrap;align-items:center;gap:24px}
.remix-btn-primary{display:inline-flex;align-items:center;gap:12px;border-radius:999px;background:#FF795B;padding:14px 32px;font-size:16px;font-weight:600;color:#fff;box-shadow:0 4px 6px rgba(255,121,91,0.2);transition:all .3s}
.remix-btn-primary:hover{background:#F96A45;box-shadow:0 8px 16px rgba(255,121,91,0.3)}
.remix-textlink{position:relative;font-size:16px;font-weight:500;color:#242424;text-decoration:underline;text-decoration-color:rgba(36,36,36,0.4);text-underline-offset:4px}
.remix-textlink:hover{color:#FF795B;text-decoration-color:#FF795B}
.tree-ref{position:relative;min-height:660px;width:100%}
@media(min-width:1024px){.tree-ref{min-height:720px}}
@media(min-width:1280px){.tree-ref{min-height:760px}}
.remix-node{position:absolute;z-index:20;display:flex;cursor:pointer;align-items:center;gap:8px;border-radius:999px;padding:6px 14px;font-size:13px;font-weight:500;transition:all .3s;border:1px dashed #aaa;background:#FAF8F5;color:rgba(36,36,36,0.65)}
@media(min-width:640px){.remix-node{font-size:14px}}
.remix-node.is-left{flex-direction:row-reverse}
.remix-node.is-lit{border:1px solid #242424;background:#fff;color:#242424;box-shadow:0 4px 12px rgba(36,36,36,0.1)}
.remix-node-logo{display:flex;width:16px;height:16px;flex:none;align-items:center;justify-content:center;opacity:0.55;filter:grayscale(1);transition:all .3s}
@keyframes subtle-flicker{0%,100%{opacity:0.45}45%{opacity:0.45}50%{opacity:0.85}55%{opacity:0.45}80%{opacity:0.75}85%{opacity:0.45}}
.remix-node:not(.is-lit) .remix-node-logo{animation:subtle-flicker var(--blink,2.4s) steps(1,end) infinite var(--blink-delay,0s)}
.remix-node.is-lit .remix-node-logo{opacity:1;filter:none;transform:scale(1.05)}
.remix-node:hover .remix-node-logo{opacity:1;filter:none}
.remix-node-label{letter-spacing:-0.01em;user-select:none;white-space:nowrap}
.remix-tooltip{pointer-events:none;position:absolute;bottom:calc(100% + 10px);z-index:30;width:224px;border-radius:12px;border:1px solid rgba(36,36,36,0.15);background:#fff;padding:12px;box-shadow:0 12px 32px rgba(36,36,36,0.1);transition:all .3s;opacity:0;transform:translateY(8px) scale(0.95)}
.remix-node.is-left .remix-tooltip{right:0}
.remix-node:not(.is-left) .remix-tooltip{left:0}
.remix-node.is-lit .remix-tooltip{opacity:1;transform:translateY(0) scale(1)}
.remix-node.is-lit .remix-node-logo{opacity:1;filter:none;color:#FF795B}
.remix-tooltip-head{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:#242424}
.remix-tooltip-nr{display:inline-flex;height:16px;min-width:16px;align-items:center;justify-content:center;border-radius:999px;background:rgba(36,36,36,0.1);padding:0 4px;font-size:10px;font-weight:700;color:#242424}
.remix-tooltip-desc{margin-top:6px;font-size:12px;line-height:1.4;color:rgba(36,36,36,0.8)}
.meter-card{position:absolute;left:48%;transform:translateX(-50%);bottom:-16px;z-index:20;width:290px;border-radius:16px;border:1px solid rgba(36,36,36,0.15);background:#fff;padding:16px;box-shadow:0 12px 32px rgba(36,36,36,0.08);transition:all .3s}
@media(min-width:640px){.meter-card{width:310px}}
.meter-check{position:absolute;top:-14px;right:24px;display:flex;height:28px;width:28px;align-items:center;justify-content:center;border-radius:50%;background:#03624c;color:#fff;box-shadow:0 4px 8px rgba(3,98,76,0.3);font-size:14px;font-weight:700}
.meter-tabs{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid rgba(36,36,36,0.1);padding-bottom:12px;text-align:left}
.meter-tab{padding:0 8px;text-align:left;background:none;border:0;cursor:pointer;opacity:0.65}
.meter-tab.active{opacity:1}
.meter-tab-label{display:block;font-size:11px;font-weight:500;color:rgba(36,36,36,0.7)}
.meter-tab.active .meter-tab-label{color:#2563eb;text-decoration:underline;text-decoration-color:#2563eb;text-decoration-thickness:2px;text-underline-offset:4px}
.meter-tab-value{display:block;margin-top:4px;font-size:18px;font-weight:700;letter-spacing:-0.02em;color:#242424}
.meter-chart-wrap{position:relative;margin-top:8px;height:80px;width:100%}
.meter-chart{height:100%;width:100%;overflow:visible}
.meter-hover-cols{position:absolute;inset:0;display:flex}
.meter-hover-col{height:100%;flex:1;cursor:pointer}
.meter-y{pointer-events:none;position:absolute;top:4px;right:0;display:flex;flex-direction:column;justify-content:space-between;font-size:9px;color:#9ca3af}
.meter-dates{margin-top:4px;display:flex;align-items:center;justify-content:space-between;font-size:10px;color:#9ca3af}
.meter-legend{margin-top:12px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(36,36,36,0.1);padding-top:10px;font-size:10px;color:rgba(36,36,36,0.75)}
.legend-line{display:inline-block;height:2px;width:12px;border-radius:999px;background:#2563eb;vertical-align:middle;margin-right:6px}
.legend-dash{display:inline-block;height:2px;width:12px;border-top:1px dashed #9ca3af;vertical-align:middle;margin-right:6px}
.groei-wrap{pointer-events:none;position:absolute;top:-32px;right:-112px;display:none}
@media(min-width:640px){.groei-wrap{display:block}}
.groei-text{display:block;font-family:Schoolbell, cursive;font-size:18px;font-weight:700;color:#242424;transform:rotate(-4deg)}
.groei-arrow{margin-top:4px;height:48px;width:80px;color:#242424;overflow:visible}
</style>
<script>
const CHART = [{"l":12,"v":490,"c":2.4},{"l":14,"v":520,"c":2.6},{"l":11,"v":460,"c":2.3},{"l":16,"v":580,"c":2.7},{"l":10,"v":430,"c":2.3},{"l":9,"v":380,"c":2.3},{"l":8,"v":350,"c":2.2},{"l":15,"v":540,"c":2.7},{"l":13,"v":510,"c":2.5},{"l":18,"v":610,"c":2.9},{"l":15,"v":530,"c":2.8},{"l":14,"v":520,"c":2.6},{"l":11,"v":410,"c":2.6},{"l":10,"v":390,"c":2.5},{"l":19,"v":640,"c":2.9},{"l":22,"v":720,"c":3},{"l":26,"v":790,"c":3.2},{"l":21,"v":690,"c":3},{"l":20,"v":670,"c":2.9},{"l":15,"v":480,"c":3.1},{"l":14,"v":460,"c":3},{"l":25,"v":780,"c":3.2},{"l":31,"v":890,"c":3.4},{"l":33,"v":920,"c":3.5},{"l":27,"v":810,"c":3.3},{"l":23,"v":750,"c":3},{"l":18,"v":540,"c":3.3},{"l":17,"v":520,"c":3.2}];
const PREV = [{"l":10,"v":450,"c":2.2},{"l":11,"v":480,"c":2.2},{"l":9,"v":420,"c":2.1},{"l":12,"v":500,"c":2.4},{"l":8,"v":380,"c":2.1},{"l":7,"v":340,"c":2},{"l":7,"v":330,"c":2.1},{"l":11,"v":470,"c":2.3},{"l":10,"v":460,"c":2.1},{"l":13,"v":520,"c":2.5},{"l":12,"v":490,"c":2.4},{"l":11,"v":470,"c":2.3},{"l":8,"v":380,"c":2.1},{"l":7,"v":350,"c":2},{"l":12,"v":500,"c":2.4},{"l":14,"v":530,"c":2.6},{"l":15,"v":560,"c":2.6},{"l":14,"v":540,"c":2.5},{"l":13,"v":510,"c":2.5},{"l":9,"v":410,"c":2.1},{"l":8,"v":390,"c":2},{"l":13,"v":520,"c":2.5},{"l":14,"v":550,"c":2.5},{"l":15,"v":570,"c":2.6},{"l":14,"v":540,"c":2.5},{"l":12,"v":500,"c":2.4},{"l":9,"v":420,"c":2.1},{"l":9,"v":410,"c":2.1}];
function trunkPath(o, spineX, targetY, R=20){ const s=o.x, a=o.y; if(Math.abs(spineX-s)<2) return `M ${spineX},${a} V ${targetY}`; const dirX=Math.sign(spineX-s); const dirY=Math.sign(targetY-a)||1; const r=Math.min(R, Math.abs(targetY-a)/2, Math.abs(spineX-s)); return `M ${s},${a} H ${spineX - dirX*r} Q ${spineX},${a} ${spineX},${a + dirY*r} V ${targetY}`; }
let activeId = null; let hoveredId = null; let selectedMetric = 'leads'; let chartHoverIdx = null; let nodeCustomTops = {};
function currentLit(){ return hoveredId || activeId; }
function renderChart(){
  const W=272, H=64, pb=12, pt=6, ah=H-pb-pt;
  const key = selectedMetric==='leads' ? 'l' : selectedMetric==='verkeer' ? 'v' : 'c';
  const vals = CHART.map(d=>d[key]); const prev = PREV.map(d=>d[key]);
  const max = Math.max(...vals, ...prev)*1.05;
  const pts = (arr)=>arr.map((v,i)=>{ const x=(i/(arr.length-1))*(W-16)+8; const y=H-pb-((v-0)/max)*ah; return {x,y,val:v}; });
  const cur = pts(vals); const prv = pts(prev);
  const path = (ps)=>ps.reduce((acc,p,i)=>{ if(i===0) return `M ${p.x.toFixed(1)},${p.y.toFixed(1)}`; const prevP=ps[i-1]; const cx=(prevP.x+p.x)/2; return `${acc} C ${cx.toFixed(1)},${prevP.y.toFixed(1)} ${cx.toFixed(1)},${p.y.toFixed(1)} ${p.x.toFixed(1)},${p.y.toFixed(1)}`; },'');
  const curPath = path(cur); const prevPath = path(prv);
  const area = `${curPath} L ${cur[cur.length-1].x},${H-pb} L ${cur[0].x},${H-pb} Z`;
  document.getElementById('chartCurr').setAttribute('d', curPath);
  document.getElementById('chartPrev').setAttribute('d', prevPath);
  document.getElementById('chartArea').setAttribute('d', area);
  const g = document.getElementById('chartHoverG');
  if(chartHoverIdx!==null && cur[chartHoverIdx]){ g.style.display='block'; const p=cur[chartHoverIdx]; const l=document.getElementById('chartHoverLine'); l.setAttribute('x1',p.x); l.setAttribute('x2',p.x); const d=document.getElementById('chartHoverDot'); d.setAttribute('cx',p.x); d.setAttribute('cy',p.y); } else { g.style.display='none'; }
}
function renderWires(){
  const hero = document.getElementById('omnimerce-hero'); const hart = document.getElementById('hart'); const tree = document.getElementById('treeRef'); const card = document.getElementById('meterCard');
  if(!hero || !hart) return;
  const heroRect = hero.getBoundingClientRect(); const dotRect = hart.getBoundingClientRect();
  const origin = { x: dotRect.left + dotRect.width/2 - heroRect.left, y: dotRect.top + dotRect.height/2 - heroRect.top };
  let spineX = heroRect.width * 0.72; if(tree){ const tr = tree.getBoundingClientRect(); spineX = tr.left - heroRect.left + tr.width * 0.48;
    if(card){
      const cardRect = card.getBoundingClientRect(); const cardTopInTree = cardRect.top - tr.top; const safeMaxNodeCenter = cardTopInTree - 44; const martechProjectedCenter = (70/100) * tr.height;
      if(martechProjectedCenter > safeMaxNodeCenter){
        const originYInTree = origin.y - (tr.top - heroRect.top); const lowerStart = originYInTree + 32; const lowerEnd = safeMaxNodeCenter; const lowerSpan = Math.max(lowerEnd - lowerStart, 110);
        const newTops = {}; const lowerIds = ['automatisering','tracking','martech']; lowerIds.forEach((id, idx)=>{ newTops[id] = lowerStart + (idx/(lowerIds.length-1))*lowerSpan; });
        const upperStart = 28; const upperEnd = originYInTree - 32; const upperSpan = Math.max(upperEnd - upperStart, 120); const upperIds = ['seo','geo','positionering','taalregister','governance']; upperIds.forEach((id, idx)=>{ newTops[id] = upperStart + (idx/(upperIds.length-1))*upperSpan; });
        let changed = Object.keys(newTops).some(k=>Math.abs((nodeCustomTops[k]||0) - newTops[k]) > 1.5);
        if(changed){ nodeCustomTops = newTops; document.querySelectorAll('.remix-node').forEach(el=>{ const id=el.getAttribute('data-id'); if(nodeCustomTops[id]!==undefined) el.style.top = nodeCustomTops[id]+'px'; }); }
      } else if(Object.keys(nodeCustomTops).length>0){ nodeCustomTops = {}; document.querySelectorAll('.remix-node').forEach(el=>{ el.style.top=''; }); }
    }
  }
  const R = 20; const baseG = document.getElementById('baseWires'); const cardG = document.getElementById('cardWireG'); const activeG = document.getElementById('activeWireG');
  baseG.innerHTML=''; cardG.innerHTML=''; activeG.innerHTML=''; const lit = currentLit(); const branches = {};
  document.querySelectorAll('.remix-node').forEach((el)=>{
    const id = el.getAttribute('data-id'); const side = el.getAttribute('data-side'); const r = el.getBoundingClientRect();
    const nodeX = r.left - heroRect.left; const nodeY = r.top - heroRect.top; const nodeW = r.width; const nodeH = r.height;
    const targetY = nodeY + nodeH/2; const targetX = side==='L' ? nodeX + nodeW : nodeX;
    const dirX = side==='L' ? -1 : 1; const dirY = Math.sign(targetY - origin.y) || 1;
    const cornerR = Math.min(R, Math.abs(targetX - spineX)*0.6);
    const trunk = trunkPath(origin, spineX, targetY - dirY*cornerR, R);
    const d = `${trunk} Q ${spineX},${targetY} ${spineX + dirX*cornerR},${targetY} H ${targetX}`;
    branches[id]=d; const isLit = lit===id;
    const p = document.createElementNS('http://www.w3.org/2000/svg','path'); p.setAttribute('d', d); p.setAttribute('fill','none'); p.setAttribute('stroke', isLit ? '#242424' : 'rgba(36,36,36,0.14)'); p.setAttribute('stroke-width', isLit ? 1.75 : 1.25); p.setAttribute('stroke-dasharray', isLit ? 'none' : '4 3'); p.setAttribute('stroke-linecap','round'); p.style.transition='all .3s'; baseG.appendChild(p);
    el.classList.toggle('is-left', side==='L'); el.classList.toggle('is-lit', isLit);
  });
  if(card){
    const c = card.getBoundingClientRect(); const cardX = c.left - heroRect.left; const cardY = c.top - heroRect.top; const cardW = c.width;
    const targetX = cardX + cardW/2; const targetY = cardY;
    let d; if(Math.abs(targetX - spineX) < 4){ d = trunkPath(origin, spineX, targetY, R); } else { const stepUp = targetY - 24; const dirX = Math.sign(targetX - spineX); const cornerR = Math.min(R,16); const trunk = trunkPath(origin, spineX, stepUp - cornerR, R); d = `${trunk} Q ${spineX},${stepUp} ${spineX + dirX*cornerR},${stepUp} H ${targetX - dirX*cornerR} Q ${targetX},${stepUp} ${targetX},${stepUp + cornerR} V ${targetY}`; }
    window.__cardBranch = d;
    const p = document.createElementNS('http://www.w3.org/2000/svg','path'); p.setAttribute('d', d); p.setAttribute('fill','none'); p.setAttribute('stroke', lit==='card' ? '#242424' : 'rgba(36,36,36,0.14)'); p.setAttribute('stroke-width', lit==='card' ? 1.75 : 1.25); p.setAttribute('stroke-dasharray', lit==='card' ? 'none' : '4 3'); p.setAttribute('stroke-linecap','round'); p.style.transition='all .3s'; cardG.appendChild(p);
  }
  hart.classList.toggle('pulse-on', !!(lit && branches[lit]));
  if(lit && branches[lit]){
    const p = document.createElementNS('http://www.w3.org/2000/svg','path'); p.setAttribute('d', branches[lit]); p.setAttribute('fill','none'); p.setAttribute('stroke','#242424'); p.setAttribute('stroke-width','2'); p.setAttribute('stroke-linecap','round'); p.style.transition='all .3s'; activeG.appendChild(p);
    const pulse = document.createElementNS('http://www.w3.org/2000/svg','path'); pulse.setAttribute('d', branches[lit]); pulse.setAttribute('fill','none'); pulse.setAttribute('stroke','#FF795B'); pulse.setAttribute('stroke-width','2.5'); pulse.setAttribute('stroke-linecap','round'); pulse.setAttribute('stroke-dasharray','40 260'); pulse.style.animation='pulse-signal 1.8s linear infinite'; activeG.appendChild(pulse);
  }
}
function bind(){
  document.querySelectorAll('.remix-node').forEach((el)=>{ el.addEventListener('mouseenter', ()=>{ hoveredId = el.getAttribute('data-id'); renderWires(); }); el.addEventListener('mouseleave', ()=>{ hoveredId = null; renderWires(); }); el.addEventListener('click', ()=>{ activeId = el.getAttribute('data-id'); renderWires(); }); el.addEventListener('focus', ()=>{ hoveredId = el.getAttribute('data-id'); renderWires(); }); el.addEventListener('blur', ()=>{ hoveredId = null; renderWires(); }); });
  const card = document.getElementById('meterCard'); if(card){ card.addEventListener('mouseenter', ()=>{ hoveredId='card'; renderWires(); }); card.addEventListener('mouseleave', ()=>{ hoveredId=null; renderWires(); }); }
  const hart = document.getElementById('hart'); if(hart){ hart.addEventListener('click', ()=>{ activeId = activeId ? null : 'positionering'; renderWires(); }); }
  document.querySelectorAll('.meter-tab').forEach((b)=>{ b.addEventListener('click', ()=>{ selectedMetric = b.getAttribute('data-metric'); document.querySelectorAll('.meter-tab').forEach(x=>x.classList.remove('active')); b.classList.add('active'); renderChart(); }); });
  const cols = document.getElementById('meterHoverCols'); if(cols){ cols.innerHTML=''; for(let i=0;i<28;i++){ const d=document.createElement('div'); d.className='meter-hover-col'; d.addEventListener('mouseenter', ()=>{ chartHoverIdx=i; renderChart(); }); cols.appendChild(d); } cols.addEventListener('mouseleave', ()=>{ chartHoverIdx=null; renderChart(); });
  const wrap = cols.parentElement; if(wrap){ wrap.addEventListener('mousemove', (e)=>{ const r = wrap.getBoundingClientRect(); if(!r.width) return; const ratio = (e.clientX - r.left) / r.width; const i = Math.max(0, Math.min(27, Math.floor(ratio * 28))); if(i !== chartHoverIdx){ chartHoverIdx = i; renderChart(); } }); wrap.addEventListener('mouseleave', ()=>{ chartHoverIdx=null; renderChart(); }); } }
  window.addEventListener('resize', renderWires); setInterval(renderWires, 500);
}
renderChart(); bind(); renderWires();
</script>

---
// Image placeholder. No images are generated for the Omnimerce build (per brief section 6).
// `desc` is the recommended real image for this slot, kept visible as a caption and in the markup
// so a real asset can be dropped in later without redesigning the section. Swap this component's
// body for an <img> with the same aspect class when the real asset arrives.
const { desc, ratio = 'wide', label = 'Image' } = Astro.props;
const cls = ratio === 'std' ? 'imgph imgph--std' : ratio === 'tall' ? 'imgph imgph--tall' : 'imgph imgph--wide';
---
<figure class={cls} role="img" aria-label={desc} style="margin:0">
  <span class="imgph-tag">{label} placeholder</span>
  <span class="imgph-label">{desc}</span>
</figure>
<!-- recommended image: {desc} -->

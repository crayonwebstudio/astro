---
import Base from '../../layouts/Base.astro';
import ImgPh from '../../components/ImgPh.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Crumb from '../../components/Crumb.astro';
import { industries, SITE_URL } from '../../data/omnimerce.ts';

export function getStaticPaths() {
  return industries.map(i => ({ params: { slug: i.slug }, props: { ind: i } }));
}
const { ind } = Astro.props;
const pageUrl = `${SITE_URL}/industries/${ind.slug}/`;
const jsonLd = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: `${SITE_URL}/industries/` },
    { '@type': 'ListItem', position: 3, name: ind.name, item: pageUrl },
  ] },
];
const checkSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" style="color:var(--vivid);flex:none;margin-top:2px"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,0,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg>';
---
<Base title={ind.title} description={ind.metaDesc} jsonLd={jsonLd}>
  <section class="om-hero"><div class="wrap">
    <Crumb trail={[{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }, { label: ind.name }]} />
    <div class="split">
      <div>
        <h1>{ind.h1}</h1>
        <div class="prose-en" style="margin-top:22px">{ind.heroParas.map((p: string) => <p>{p}</p>)}</div>
        <div class="hero-actions" style="margin-top:28px"><a class="btn btn-lg" href="/contact/">{ind.heroCta} &rarr;</a></div>
      </div>
      <ImgPh desc={ind.heroImage} ratio="wide" label="Hero image" />
    </div>
  </div></section>

  {(ind.challenges || ind.improve) && (
    <section class="om-sec"><div class="wrap">
      <h2 class="kop-sectie">{ind.challenges ? 'Common challenges' : 'What we improve'}</h2>
      <ul class="checklist list-cols">
        {(ind.challenges ?? ind.improve).map((it: string) => <li style="display:flex;gap:10px"><span set:html={checkSvg} /><span style="color:var(--deep);font-size:15px">{it}</span></li>)}
      </ul>
    </div></section>
  )}

  <section class="om-sec om-sec--raised"><div class="wrap">
    <h2 class="kop-sectie">Our approach</h2>
    <div class="prose-en" style="margin-top:16px">{ind.approachParas.map((p: string) => <p>{p}</p>)}</div>
    {ind.capabilities && (
      <>
        <h3 style="margin-top:36px;font-size:22px">Capabilities</h3>
        <ul class="checklist list-cols">
          {ind.capabilities.map((it: string) => <li style="display:flex;gap:10px"><span set:html={checkSvg} /><span style="color:var(--deep);font-size:15px">{it}</span></li>)}
        </ul>
      </>
    )}
  </div></section>

  <section class="om-sec"><div class="wrap">
    <h2 class="kop-sectie">Frequently asked questions</h2>
    <FaqList items={ind.faq} />
  </div></section>

  <CtaBand h2={ind.ctaH2} primaryLabel={ind.heroCta} />
</Base>

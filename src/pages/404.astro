---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | Omnimerce" description="The page you are looking for could not be found. Explore Omnimerce solutions or contact us for help.">
  <section class="om-hero"><div class="wrap">
    <p class="eyebrow">404</p>
    <h1>This page could not be found.</h1>
    <p class="lead" style="margin-top:18px">The page may have moved as the site was reorganized. Start from one of these instead:</p>
    <div class="hero-actions" style="margin-top:28px">
      <a class="btn btn-lg" href="/solutions/">Explore Our Solutions &rarr;</a>
      <a class="textlink" href="/contact/">Contact Omnimerce</a>
    </div>
  </div></section>
</Base>

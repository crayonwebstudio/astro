---
import Base from '../layouts/Base.astro';

// Insights articles are in preparation. Topics are shown honestly as planned
// articles, never as published posts with invented authors or dates.
const posts = [
  { title: "How to connect Amazon inventory with ERPNext", description: "A practical guide to SKU mapping, stock allocation, synchronization frequency and overselling prevention.", tag: "Marketplace Integration" },
  { title: "What product data do you need before using AI content?", description: "The minimum verified product information required to generate useful descriptions and images.", tag: "AI Product Content" },
  { title: "How to calculate true marketplace profitability", description: "A framework for combining product cost, commissions, shipping, advertising, returns and settlement differences.", tag: "Ecommerce Operations" },
  { title: "Why marketplace integrations fail", description: "Common causes of duplicate orders, stale stock, failed retries and reconciliation problems.", tag: "Integrations" },
  { title: "How to prepare your product catalogue for AI-generated images", description: "Reference images, product facts, brand rules and review processes for AI product imagery.", tag: "AI Product Content" },
  { title: "Technical SEO checks every ecommerce store should run", description: "A practical framework for crawlability, indexation, duplicate content, templates and structured data.", tag: "Ecommerce SEO" },
  { title: "What is AEO and GEO in ecommerce?", description: "How answer engines and generative search change the way product and service information should be structured.", tag: "Ecommerce SEO" },
  { title: "Manufacturing inventory explained for online sellers", description: "BOMs, work orders, material consumption and finished-goods availability for businesses that make what they sell.", tag: "Manufacturing" },
];
---
<Base title="Ecommerce Insights | ERP, AI, Marketplaces & SEO · Omnimerce" description="Read practical Omnimerce insights on ecommerce ERP, marketplace integrations, manufacturing, AI product content, SEO and business automation.">
<section class="hero"><div class="wrap"><p class="eyebrow">Insights</p><h1>Ideas and guidance for better ecommerce operations<span class="text-vivid">.</span></h1><p class="lead">Omnimerce Insights will publish practical guidance for ecommerce businesses that want better connected systems, more efficient operations and useful AI implementation. These articles are currently in preparation.</p></div></section>
<section><div class="wrap"><div class="services">
{posts.map((post) => (
  <article class="svc" style="min-height:0">
    <p style="color:var(--muted);font-size:14px;margin:18px 0 0">Coming soon · {post.tag}</p>
    <h2 style="margin:10px 0 10px">{post.title}</h2>
    <p style="color:var(--muted)">{post.description}</p>
  </article>
))}
</div></div></section>
</Base>

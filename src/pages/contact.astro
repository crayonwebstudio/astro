---
import Base from '../layouts/Base.astro';
import { contactPage, site } from '../data/content.ts';
const siteUrl = 'https://astro.woodwolfdigital.com';
const jsonLd = [
  { '@type': 'ContactPage', '@id': `${siteUrl}/contact/#webpage`, url: `${siteUrl}/contact/`, inLanguage: 'en', isPartOf: { '@id': `${siteUrl}/#website` }, name: 'Contact', mainEntity: { '@id': `${siteUrl}/#organization` }, publisher: { '@id': `${siteUrl}/#organization` }, breadcrumb: { '@id': `${siteUrl}/contact/#breadcrumb` } },
  { '@type': 'BreadcrumbList', '@id': `${siteUrl}/contact/#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Omnimerce', item: `${siteUrl}/` }, { '@type': 'ListItem', position: 2, name: 'Contact', item: `${siteUrl}/contact/` }] },
];
---
<Base title="Contact Omnimerce | Discuss Your Ecommerce Project" description="Contact Omnimerce to discuss ERP, marketplace integration, manufacturing, AI content or custom ecommerce solutions for your business." jsonLd={jsonLd}>
<section class="hero"><div class="wrap"><p class="eyebrow">{contactPage.eyebrow}</p><h1>{contactPage.title}</h1><p class="lead">{contactPage.lead}</p></div></section>

<section><div class="wrap"><div class="contact-grid">
<div><p><a class="btn" href={contactPage.calendarHref} target="_blank" rel="noopener">{contactPage.calendarLabel} &rarr;</a></p><ul style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px 20px;list-style:none;padding:0">{contactPage.calendarDetails.map(d => <li>{d}</li>)}</ul><p style="margin-top:14px"><a class="textlink" href={contactPage.messageLinkHref}>{contactPage.messageLinkLabel}</a></p><div class="bullets-block"><p class="bullets-title">{contactPage.bulletsTitle}</p><ul class="checklist">{contactPage.bullets.map(b => <li>{b}</li>)}</ul></div></div>
<figure class="contact-figure"><div class="img-wrap"><img src={contactPage.image} alt={contactPage.imageAlt} width="1122" height="1402" /></div><figcaption><span>{contactPage.founderName}</span></figcaption></figure>
</div></div></section>

<section id="bericht" class="section-top"><div class="wrap"><div class="contact-form-grid">
<div><h2 class="kop-sectie">{contactPage.formTitle}</h2><div class="prose">{contactPage.formIntro.map(p => <p>{p}</p>)}</div><div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px"><a class="btn-outline" href={`mailto:${site.email}`}><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM203.43,64,128,133.15,52.57,64ZM216,192H40V74.19l82.59,75.71a8,8,0,0,0,10.82,0L216,74.19V192Z"></path></svg>{contactPage.emailLabel}</a></div><p style="margin-top:16px;font-size:14px;color:var(--muted)">{site.email}</p></div>
<form class="card form-card" onsubmit="return false">
<!-- Form is front-end only until the Omnimerce enquiry endpoint is connected. No endpoint invented. -->
<div class="form-grid">
<div><label for="naam">Full name</label><input class="input" id="naam" name="naam" autocomplete="name" required /></div>
<div><label for="email">Business email</label><input class="input" id="email" name="email" type="email" autocomplete="email" required /></div>
<div><label for="organisatie">{contactPage.companyFieldLabel}</label><input class="input" id="organisatie" name="organisatie" autocomplete="organization" /></div>
<div><label for="telefoon">Phone number (optional)</label><input class="input" id="telefoon" name="telefoon" type="tel" autocomplete="tel" /></div>
<div class="full"><label for="toelichting">{contactPage.helpFieldLabel}</label><p class="field-hint" id="toelichting-hint">{contactPage.privacyNote}</p><textarea class="input" id="toelichting" name="toelichting" rows="5" required aria-describedby="toelichting-hint"></textarea></div>
<div class="full"><label style="display:flex;gap:10px;align-items:flex-start;margin-top:14px"><input type="checkbox" id="toestemming" name="toestemming" style="margin-top:4px" /><span>{contactPage.consentText}<a href="/privacy-policy/">privacy policy</a>.</span></label></div>
</div>
<div aria-hidden="true" style="position:absolute;left:-9999px;top:0;height:1px;width:1px;overflow:hidden"><label for="bedrijfsnaam-bevestiging">{contactPage.honeypotLabel}</label><input class="input" id="bedrijfsnaam-bevestiging" name="bedrijfsnaam_bevestiging" type="text" tabindex="-1" autocomplete="off" /></div>
<div style="margin-top:28px"><button class="btn btn-full" type="submit">Send your enquiry &rarr;</button></div>
<p class="note" style="margin-top:24px">{contactPage.formPrivacyNote}</p>
</form>
</div></div></section>
</Base>

---
import Base from '../layouts/Base.astro';
import { contactPage, site } from '../data/content.ts';
---
<Base title={`${contactPage.title} - ${site.name}`}>
<section class="hero"><div class="wrap"><h1>{contactPage.title}</h1><p class="lead">{contactPage.lead}</p></div></section>
<section><div class="wrap"><div class="two-col">
<div class="card"><p><b>{contactPage.emailLabel}</b><br /><a href={`mailto:${site.email}`}>{site.email}</a></p><p><b>{contactPage.phoneLabel}</b><br /><a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a></p><p class="note">Dit formulier is een voorbeeld zonder backend. Koppel het aan Formspree, Netlify Forms of je eigen endpoint als je inzendingen wilt ontvangen.</p></div>
<form class="card" onsubmit="return false"><label>Naam</label><input class="input" placeholder="Je naam" /><label>E-mail</label><input class="input" type="email" placeholder="je@mail.nl" /><label>Bericht</label><textarea class="input" rows="5" placeholder="Wat wil je bereiken?"></textarea><button class="btn" style="margin-top:18px">Verstuur &rarr;</button></form>
</div></div></section>
</Base>

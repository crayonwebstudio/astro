---
import Base from '../layouts/Base.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import { site, home } from '../data/content.ts';
---
<Base>
<HeroDiagram />

<section><div class="wrap"><div class="quote-grid">
<p class="quote"><em>&ldquo;</em>{home.quote}<em>&rdquo;</em></p>
<div class="prose">{home.quoteBody.map(p => <p>{p}</p>)}</div>
</div></div></section>

<section id="expertise"><div class="wrap">
<h2 class="kop-sectie">{home.servicesTitle}</h2>
<div class="services">
<div class="svc-img" style="padding:0;overflow:hidden"><img src="/diensten-beeld-1.jpg" alt="" width="1600" height="744" style="width:100%;height:100%;object-fit:cover" /></div>
{home.services.slice(0,2).map(s => <a class="svc" href={s.href}><span class="arrow">&nearr;</span><h3>{s.title}</h3><ul>{s.points.map(pt => <li>{pt}</li>)}</ul></a>)}
{home.services.slice(2).map(s => <a class="svc" href={s.href}><span class="arrow">&nearr;</span><h3>{s.title}</h3><ul>{s.points.map(pt => <li>{pt}</li>)}</ul></a>)}
<div class="svc-img" style="padding:0;overflow:hidden"><img src="/diensten-beeld-2.jpg" alt="" width="1600" height="744" style="width:100%;height:100%;object-fit:cover" /></div>
</div>
</div></section>

<section><div class="wrap"><div class="about-grid">
<figure class="about-img" style="padding:0;overflow:hidden;margin:0"><img src="/kennismaking-dylan.jpg" alt="Dylan van den Bosch aan een houten tafel achter zijn laptop." width="1122" height="1402" style="width:100%;height:100%;object-fit:cover;aspect-ratio:4/5" /></figure>
<div><p class="eyebrow">{home.aboutEyebrow}</p><h2 class="kop-sectie" style="margin-top:12px">{home.aboutTitle}</h2><div class="prose" style="margin-top:28px">{home.aboutBody.map(p => <p>{p}</p>)}</div><div class="hero-actions"><a class="btn" href={home.aboutCtaHref}>{home.aboutCtaLabel} &rarr;</a><a class="textlink" href={home.aboutLinkHref}>{home.aboutLinkLabel}</a></div></div>
</div></div></section>

<section><div class="wrap">
<p class="eyebrow">Werkwijze</p><h2 class="kop-sectie" style="margin-top:12px">{home.processTitle}</h2>
<div class="steps">{home.processSteps.map((s,i) => <div class="step"><b>0{i+1}</b><h3>{s.title}</h3><p style="color:var(--muted)">{s.text}</p></div>)}</div>
<p style="margin-top:22px"><a class="textlink" href={home.processLinkHref}>{home.processLinkLabel} &rarr;</a></p>
</div></section>
</Base>

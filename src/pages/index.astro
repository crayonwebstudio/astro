---
import Base from '../layouts/Base.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import { site, home } from '../data/content.ts';
---
<Base>
<HeroDiagram />

<section><div class="wrap"><div class="quote-grid">
<p class="quote"><em>&ldquo;</em>{home.quote.split('Omnimerce').map((part, i) => i === 0 ? part : <><span class="text-vivid">Omnimerce</span>{part}</>)}<em>&rdquo;</em></p>
<div class="prose">{home.quoteBody.map(p => <p>{p}</p>)}</div>
</div></div></section>

<section id="clusters"><div class="wrap">
<h2 class="kop-sectie">{home.servicesTitle}</h2>
<div class="services">
<div class="svc-img" style="padding:0;overflow:hidden"><img src="/diensten-beeld-1.jpg" alt="" width="1600" height="744" style="width:100%;height:100%;object-fit:cover" /></div>
{home.services.slice(0,2).map((s, i) => <a class="svc" id={['fundament','zichtbaarheid'][i]} href={s.href}><svg class="arrow" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z"></path></svg><h3>{s.title}</h3><ul>{s.points.map(pt => <li>{pt}</li>)}</ul></a>)}
{home.services.slice(2).map((s, i) => <a class="svc" id={['merk-en-taal','ai-werkmodel'][i]} href={s.href}><svg class="arrow" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M204,64V168a12,12,0,0,1-24,0V93L72.49,200.49a12,12,0,0,1-17-17L163,76H88a12,12,0,0,1,0-24H192A12,12,0,0,1,204,64Z"></path></svg><h3>{s.title}</h3><ul>{s.points.map(pt => <li>{pt}</li>)}</ul></a>)}
<div class="svc-img" style="padding:0;overflow:hidden"><img src="/diensten-beeld-2.jpg" alt="" width="1600" height="744" style="width:100%;height:100%;object-fit:cover" /></div>
</div>
</div></section>

<section><div class="wrap"><div class="about-grid home-about">
<figure class="about-img" style="padding:0;overflow:hidden;margin:0"><img src="/kennismaking-dylan.jpg" alt={home.aboutImageAlt} width="1122" height="1402" style="width:100%;height:100%;object-fit:cover;aspect-ratio:4/5" /></figure>
<div><p style="font-size:14px;color:rgba(36,36,36,.62)">{home.aboutEyebrow}</p><h2 class="kop-sectie" style="margin-top:12px;max-width:24ch">{home.aboutTitle}<span class="text-vivid">.</span></h2><div class="prose" style="max-width:52ch">{home.aboutBody.map(p => <p>{p}</p>)}</div><div class="hero-actions"><a class="btn" href={home.aboutCtaHref}>{home.aboutCtaLabel} &rarr;</a><a class="textlink" href={home.aboutLinkHref}>{home.aboutLinkLabel}</a></div></div>
</div></div></section>

<section><div class="wrap">
<h2 class="kop-sectie leeskolom">{home.processTitle}.</h2>
<div class="steps leeskolom">{home.processSteps.map((s,i) => <div class="step"><b>0{i+1}</b><div class="step-body"><h3>{s.title}</h3><p style="color:var(--muted)">{s.text}</p></div></div>)}</div>
<p class="leeskolom process-link"><a class="textlink" href={home.processLinkHref}>{home.processLinkLabel} &rarr;</a></p>
</div></section>

<section><div class="wrap">
<h2 class="kop-sectie">{home.faqTitle}</h2>
<div class="faq" style="margin-top:32px">{home.faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
<p style="margin-top:28px"><a class="textlink" href={home.faqLinkHref}>{home.faqLinkLabel} &rarr;</a></p>
</div></section>
</Base>

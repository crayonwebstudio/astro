---
import Base from '../layouts/Base.astro';
import { privacy, site } from '../data/content.ts';
const siteUrl = 'https://astro.woodwolfdigital.com';
const jsonLd = [
  { '@type': 'WebPage', '@id': `${siteUrl}/privacy/#webpage`, url: `${siteUrl}/privacy/`, inLanguage: 'nl-NL', isPartOf: { '@id': `${siteUrl}/#website` }, name: 'Privacyverklaring', publisher: { '@id': `${siteUrl}/#organisatie` }, breadcrumb: { '@id': `${siteUrl}/privacy/#kruimelpad` } },
  { '@type': 'BreadcrumbList', '@id': `${siteUrl}/privacy/#kruimelpad`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Biite', item: `${siteUrl}/` }, { '@type': 'ListItem', position: 2, name: 'Privacyverklaring', item: `${siteUrl}/privacy/` }] },
];
const email = site.email;
function linkedParts(text: string) {
  return text.split(email);
}
---
<Base title="Privacyverklaring · Biite" description={privacy.description} ogDescription="Wat Biite met je gegevens doet als je het contactformulier invult, en welke rechten je hebt." jsonLd={jsonLd}>
<section class="legal-hero"><div class="wrap"><div class="leeskolom"><h1>{privacy.title}<span class="text-vivid">.</span></h1><p class="lead">{privacy.lead}</p><p class="legal-links"><a class="textlink" href="/algemene-voorwaarden/">Algemene voorwaarden</a></p></div></div></section>
<div class="legal-body">
{privacy.sections.map(s => <section class="legal"><div class="wrap"><h2 class="kop-sectie">{s.heading}</h2><div class="prose">{s.paras.map(p => <p>{linkedParts(p).length > 1 ? linkedParts(p).map((part, i) => i === 0 ? part : <><a href={`mailto:${email}`}>{email}</a>{part}</>) : p}</p>)}</div></div></section>)}
</div>
</Base>

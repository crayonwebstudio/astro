---
import Base from '../layouts/Base.astro';

// Same hero and .faq details elements as the template's other pages.
const groups = [
  { heading: "About Omnimerce", faqs: [
    { q: "What does Omnimerce do?", a: "Omnimerce helps ecommerce businesses implement ERP systems, connect sales channels, improve manufacturing and inventory workflows, generate product content with AI-assisted processes and automate repetitive operations." },
    { q: "Does Omnimerce provide customized ecommerce solutions?", a: "Yes. Solutions are designed around your business processes, systems and operational requirements." },
    { q: "Is Omnimerce a software product or a service?", a: "Omnimerce provides tailored implementation, integration, customization and support services using suitable software platforms and custom components." },
    { q: "Does Omnimerce replace our existing systems?", a: "Not necessarily. We first assess your current systems and determine whether they should be configured, integrated, extended or replaced." },
  ]},
  { heading: "ERP, manufacturing and integrations", faqs: [
    { q: "Can Omnimerce connect our existing ERP to marketplaces?", a: "Yes, where suitable APIs and account access are available. The implementation includes product mapping, stock rules, order workflows and error handling." },
    { q: "Can you support businesses that manufacture their own products?", a: "Yes. Implementations can include bills of materials, work orders, material consumption, finished-goods inventory and product costing." },
    { q: "Can one inventory power multiple sales channels?", a: "Yes, subject to your inventory model and the available integrations. Allocation and safety-stock rules are important to avoid overselling." },
    { q: "Can you build an integration when no standard connector exists?", a: "Where a platform provides an appropriate API or export method, we can assess and develop a custom integration." },
  ]},
  { heading: "AI and growth", faqs: [
    { q: "How can AI improve ecommerce operations?", a: "AI can assist with product content, image creation, listing preparation, classification, reporting and selected workflow tasks. Its usefulness depends on accurate source data, defined rules and appropriate review." },
    { q: "Can AI create product images?", a: "Yes, subject to the selected tools and reference material. Generated images should be checked to ensure the product's shape, color, components and key features remain accurate." },
    { q: "Do you guarantee SEO rankings or AI search visibility?", a: "No. SEO and AI search visibility depend on many external factors. We focus on technical quality, useful content and measurement rather than guarantees." },
    { q: "Can you automate social media content?", a: "We can help generate and schedule content where supported integrations and account permissions are available. Publishing capabilities differ by platform." },
  ]},
  { heading: "Working with us", faqs: [
    { q: "How much does an Omnimerce project cost?", a: "Pricing depends on the systems involved, implementation scope, integrations, customization requirements, data quality and support needs. A defined proposal is provided after discovery and assessment." },
    { q: "How do we start a project?", a: "Start with a project enquiry. We will discuss your current systems, business goals and the problem you want to solve before recommending the next step." },
  ]},
];
const jsonLd = [
  { '@type': 'FAQPage', mainEntity: groups.flatMap(g => g.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))) },
];
---
<Base title="Frequently Asked Questions | Omnimerce" description="Find answers about Omnimerce, ERP implementation, marketplace integration, manufacturing, AI ecommerce content, SEO and custom integrations." jsonLd={jsonLd}>
<section class="hero"><div class="wrap"><p class="eyebrow">FAQ</p><h1>Frequently asked questions<span class="text-vivid">.</span></h1><p class="lead">Answers about Omnimerce, ERP implementation, marketplace integration, manufacturing, AI ecommerce content, SEO and custom integrations.</p></div></section>
{groups.map(g => <section><div class="wrap"><h2 class="kop-sectie">{g.heading}</h2><div class="faq" style="margin-top:32px">{g.faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>)}
</Base>

---
import Base from '../layouts/Base.astro';
import { aiEnData, site } from '../data/content.ts';
---
<Base title={`${aiEnData.title} - ${site.name}`} description={aiEnData.lead}>
<section class="hero"><div class="wrap"><div class="hero-grid"><div><h1>{aiEnData.title}<span class="text-vivid">.</span></h1><p class="lead" style="margin-top:28px">{aiEnData.lead}</p><p style="margin-top:32px"><a class="btn" href={site.ctaHref}>{site.ctaLabel} &rarr;</a> <a class="textlink" href="#rollen" style="margin-left:14px">bekijk waar AI meedoet</a></p></div><figure class="ai-hero-img"><img src={aiEnData.heroImage} alt={aiEnData.heroImageAlt} width="1122" height="1402" style="width:100%;height:100%;object-fit:cover;object-position:center 40%" /></figure></div></div></section>

<section id="rollen"><div class="wrap"><h2 class="kop-sectie">{aiEnData.rolesTitle}</h2><div class="roles-grid">{aiEnData.roles.map(r => <div class="role-card"><h3>{r.title}</h3><p>{r.text}</p></div>)}<figure class="roles-img"><img src={aiEnData.rolesImage} alt={aiEnData.rolesImageAlt} width="1609" height="977" style="width:100%;height:100%;object-fit:cover;object-position:center 30%" /></figure></div></div></section>

<section class="dark-band"><div class="wrap"><h2 class="kop-sectie">{aiEnData.agreementsTitle}</h2><div style="margin-top:28px;max-width:62ch"><p class="dm">{aiEnData.agreementsIntro}</p></div><div>{aiEnData.agreements.map(a => <div style="margin-top:28px;max-width:62ch"><h3>{a.title}</h3><p class="dm">{a.text}</p></div>)}</div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{aiEnData.principlesTitle}</h2><div class="services">{aiEnData.principles.map(p => <div class="svc"><h3>{p.title}</h3><p style="color:var(--muted)">{p.text}</p></div>)}</div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{aiEnData.relatedTitle}</h2><div class="services">{aiEnData.relatedPosts.map(p => <a class="svc" href={p.href}>{p.image && <img src={p.image} alt={(p as any).imageAlt ?? ""} width="1254" height="1254" style="width:100%;border-radius:16px;aspect-ratio:16/9;object-fit:cover" />}<span class="arrow">&nearr;</span><p style="color:var(--muted)">{p.date}</p><h3>{p.title}</h3><p style="color:var(--muted)">{p.description}</p></a>)}</div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{aiEnData.faqTitle}</h2><div class="faq" style="margin-top:32px">{aiEnData.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog over marketing en techniek · Omnimerce" description="Lessen uit het werk van Omnimerce over strategie, techniek, taal en AI. Wat opvalt als je die vier naast elkaar legt, en waar groei dan meestal vastloopt.">
<section class="hero"><div class="wrap"><p class="eyebrow">Blog</p><h1>Lessen uit het werk<span class="text-vivid">.</span></h1><p class="lead">Wat opvalt als je strategie, techniek, vindbaarheid en taal naast elkaar legt. Ik volg geen publicatieschema: een stuk komt erbij als een onderwerp steeds terugkomt in gesprekken.</p></div></section>
<section><div class="wrap"><div class="services">
{posts.map((post) => (
  <article class="svc" style="min-height:0">
    {post.data.heroImage && (
      <a href={`/blog/${post.slug}/`} aria-label={post.data.title}>
        <img src={post.data.heroImage} alt={post.data.heroAlt ?? ""} width="1254" height="1254" style="width:100%;border-radius:24px;aspect-ratio:16/9;object-fit:cover" />
      </a>
    )}
    <p style="color:var(--muted);font-size:14px;margin:18px 0 0">{fmtDate(post.data.pubDate)}{post.data.readingTime ? ` · ${post.data.readingTime}` : ''}</p>
    <h2 style="margin:10px 0 10px"><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
    <p style="color:var(--muted)">{post.data.excerpt ?? post.data.description}</p>
  </article>
))}
</div></div></section>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const fmtDate = (d: Date) =>
  d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${post.data.seoTitle ?? post.data.title} · Omnimerce`} description={post.data.description}>
<article>
<section class="hero"><div class="wrap"><p class="eyebrow">Blog</p><h1 style="font-size:clamp(36px,5vw,64px);max-width:20ch">{post.data.title}</h1><p style="display:flex;align-items:center;gap:12px;margin-top:18px"><img src="/auteur-dylan.jpg" alt="Dylan van den Bosch" width="44" height="44" style="border-radius:50%;object-fit:cover" /><span><b>{post.data.author}</b><br /><span style="color:var(--muted)">Oprichter van Omnimerce</span></span><span style="color:var(--muted)">{fmtDate(post.data.pubDate)}{post.data.readingTime ? ` · ${post.data.readingTime}` : ''}</span></p>{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.heroAlt ?? ""} width="1254" height="1254" style="width:100%;max-width:1100px;border-radius:24px;margin-top:32px;aspect-ratio:3/2;object-fit:cover" />}</div></section>
<section><div class="wrap"><div class="prose blog-prose" style="max-width:72ch"><Content /></div><div class="card" style="max-width:72ch;margin-top:40px;display:flex;gap:16px;align-items:center"><img src="/auteur-dylan.jpg" alt="Dylan van den Bosch" width="72" height="72" style="border-radius:50%;object-fit:cover;flex:none" /><div><b>{post.data.author}</b><br /><span style="color:var(--muted)">Oprichter van Omnimerce</span><br /><a href="/over/">wie is Omnimerce</a> · <a href="https://www.linkedin.com/in/dylan-van-den-bosch/">LinkedIn</a></div></div></div></section>
</article>
</Base>

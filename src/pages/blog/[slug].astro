---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const fmtDate = (d: Date) =>
  d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${post.data.title} · Biite`} description={post.data.description}>
<article>
<section class="hero"><div class="wrap"><p class="eyebrow">Blog</p><h1 style="font-size:clamp(36px,5vw,64px);max-width:20ch">{post.data.title}</h1><p class="lead" style="margin-top:18px">{fmtDate(post.data.pubDate)}{post.data.readingTime ? ` · ${post.data.readingTime}` : ''} · {post.data.author}</p>{post.data.heroImage && <img src={post.data.heroImage} alt="" style="width:100%;max-width:1100px;border-radius:24px;margin-top:32px;aspect-ratio:16/9;object-fit:cover" />}</div></section>
<section><div class="wrap"><div class="prose" style="max-width:72ch"><Content /></div></div></section>
</article>
</Base>

---
import Base from '../layouts/Base.astro';
import { voorwaarden, site } from '../data/content.ts';
const siteUrl = 'https://astro.woodwolfdigital.com';
const jsonLd = [
  { '@type': 'WebPage', '@id': `${siteUrl}/algemene-voorwaarden/#webpage`, url: `${siteUrl}/algemene-voorwaarden/`, inLanguage: 'nl-NL', isPartOf: { '@id': `${siteUrl}/#website` }, name: 'Algemene voorwaarden', publisher: { '@id': `${siteUrl}/#organisatie` }, breadcrumb: { '@id': `${siteUrl}/algemene-voorwaarden/#kruimelpad` } },
  { '@type': 'BreadcrumbList', '@id': `${siteUrl}/algemene-voorwaarden/#kruimelpad`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Biite', item: `${siteUrl}/` }, { '@type': 'ListItem', position: 2, name: 'Algemene voorwaarden', item: `${siteUrl}/algemene-voorwaarden/` }] },
];
// Group blocks into numbered clause rows. In the reference, every 'p' block is a
// numbered clause (N.1, N.2, ...) except the intro paragraph of article 1 and the
// unnumbered version line closing article 23. A 'ul' block belongs to the clause
// directly above it (e.g. the payment terms in 11.2, the cases in 13.1, 15.6).
type Row = { num: string | null; text: string; items: string[] | null; boldTerm: boolean };
const articles: { heading: string; rows: Row[] }[] = voorwaarden.articles.map((a: any, i: number) => {
  const rows: Row[] = [];
  let clause = 0;
  for (const b of a.blocks) {
    if (b.type === 'ul') {
      if (rows.length > 0) rows[rows.length - 1].items = b.items;
      continue;
    }
    const isIntro = i === 0 && rows.length === 0;
    const isVersion = i === voorwaarden.articles.length - 1 && b === a.blocks[a.blocks.length - 1];
    clause += 1;
    rows.push({ num: isIntro || isVersion ? null : `${i + 1}.${clause - (i === 0 ? 1 : 0)}`, text: b.text, items: null, boldTerm: i === 0 && !isIntro });
  }
  return { heading: a.heading, rows };
});
function termSplit(text: string) {
  const idx = text.indexOf(': ');
  if (idx === -1) return null;
  return { term: text.slice(0, idx + 1), rest: text.slice(idx + 2) };
}
---
<Base title="Algemene voorwaarden · Biite" description={voorwaarden.description} ogDescription="Wat je van Biite mag verwachten, wat Biite van jou nodig heeft, en wat er geldt als iets anders loopt dan bedoeld." jsonLd={jsonLd}>
<section class="legal-hero"><div class="wrap"><div class="leeskolom"><h1>{voorwaarden.title}<span class="text-vivid">.</span></h1><p class="lead">{voorwaarden.lead}</p><p class="company-line">{voorwaarden.companyLine}</p><p class="legal-links"><a class="textlink" href="/Biite-algemene-voorwaarden.pdf" download>Download als PDF</a><a class="textlink" href={`mailto:${site.email}`}>Vraag over deze voorwaarden</a></p></div>
<nav class="toc-card" aria-labelledby="inhoud"><h2 class="kop-sectie" id="inhoud">Inhoud</h2><ol>{voorwaarden.toc.map((t, i) => <li><a class="textlink" href={`#artikel-${i + 1}`}>{t}</a></li>)}</ol></nav>
</div></section>

<div class="legal-body">
{articles.map((a, i) => <section class="legal" id={`artikel-${i + 1}`}><div class="wrap"><h2 class="kop-sectie">{a.heading}</h2><div class="clauses">{a.rows.map(r => <div class="clause">{r.num ? <span class="clause-num">{r.num}</span> : <span class="clause-num" aria-hidden="true"></span>}<div class="clause-body">{r.boldTerm && termSplit(r.text) ? <p><strong>{termSplit(r.text)?.term}</strong> {termSplit(r.text)?.rest}</p> : <p>{r.text}</p>}{r.items ? <ul>{r.items.map(it => <li>{it}</li>)}</ul> : null}</div></div>)}</div></div></section>)}
</div>
</Base>

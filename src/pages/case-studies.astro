---
import Base from '../layouts/Base.astro';

// Case studies are published only when the business problem, delivered scope,
// verified outcome and client permission are known. The templates below show
// the fields a published study will cover; no invented results are shown.
const cases = [
  { title: "Marketplace integration case study", fields: "Business problem · Systems integrated · Delivered scope · Operational outcome · Metrics verified with the client · Implementation lessons" },
  { title: "Manufacturing and inventory case study", fields: "Business problem · Systems integrated · Delivered scope · Operational outcome · Metrics verified with the client · Implementation lessons" },
  { title: "AI product content case study", fields: "Business problem · Systems integrated · Delivered scope · Operational outcome · Metrics verified with the client · Implementation lessons" },
];
---
<Base title="Ecommerce Case Studies | Omnimerce" description="Explore future Omnimerce case studies covering ERP implementation, marketplace integration, manufacturing and AI-powered ecommerce workflows.">
<section class="hero"><div class="wrap"><p class="eyebrow">Case Studies</p><h1>Real implementation stories, published with evidence<span class="text-vivid">.</span></h1><p class="lead">Omnimerce will publish case studies only when the business problem, delivered scope, verified outcome and client permission are known. We don't publish invented client names, revenue improvements, time savings or testimonials. Detailed case studies are currently in preparation.</p></div></section>
<section><div class="wrap"><div class="services">
{cases.map((c) => (
  <article class="svc" style="min-height:0">
    <p style="color:var(--muted);font-size:14px;margin:18px 0 0">Case study in preparation</p>
    <h2 style="margin:10px 0 10px">{c.title}</h2>
    <p style="color:var(--muted)">{c.fields}</p>
  </article>
))}
</div></div></section>
</Base>

---
import Base from '../../layouts/Base.astro';
import { expertiseDetails, site } from '../../data/content.ts';
const d = expertiseDetails.find(x => x.slug === 'werken-met-ai')!;
---
<Base title={`${d.title} - ${site.name}`} description={d.description} finalCtaImage="/cta-werken-met-ai.jpg" finalCtaImageAlt="Een 3D-figuur van Dylan van den Bosch met een kop koffie, op een roze vlak.">
<section class="hero" style="padding-bottom:40px"><div class="wrap"><nav class="breadcrumb" aria-label="kruimelpad"><a href="/expertise/">Expertise</a><span>/</span><span>{d.title}</span></nav><p class="eyebrow">{d.number} {d.title}</p><h1 style="font-size:clamp(40px,5vw,72px);max-width:32ch;margin-top:24px">{d.headline}</h1><p style="margin-top:40px"><a class="btn" href={site.ctaHref}>{site.ctaLabel} &rarr;</a></p></div></section>

<section style="padding-top:48px;padding-bottom:48px"><div class="wrap"><div style="display:flex;justify-content:flex-end"><p class="detail-intro" style="margin:0">{d.lead}</p></div></div></section>

<section><div class="wrap"><div class="about-grid">
<div><h2 class="kop-sectie">{d.painTitle}</h2><dl>{d.painPoints.map(p => <div style="border-top:1px solid var(--line);padding:28px 0"><dt><b>{p.title}</b></dt><dd style="margin:12px 0 0;color:var(--muted);max-width:56ch">{p.text}</dd></div>)}</dl></div>
<figure class="about-img" style="padding:0;overflow:hidden;margin:0;aspect-ratio:3/4"><img src={d.painImage} alt={d.painImageAlt} width="800" height="1200" style="width:100%;height:100%;object-fit:cover" /></figure>
</div></div></section>

{d.extraNoteTitle && <section><div class="wrap"><h2 class="kop-sectie">{d.extraNoteTitle}</h2><div class="prose" style="margin-top:28px;max-width:62ch"><p>{d.extraNote}</p></div></div></section>}

<section><div class="wrap"><h2 class="kop-sectie">{d.whatYouGetTitle}</h2><div class="prose" style="margin-top:32px;max-width:68ch">{d.whatYouGet.map(w => <p>{w.body}</p>)}</div></div></section>

<section class={`proc-${d.processBg}`}><div class="wrap"><h2 class="kop-sectie" style="text-align:center;max-width:24ch;margin:0 auto">{d.processTitle}</h2><div class="proc-steps">{d.process.map(s => <article><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{d.sameTitle}</h2><dl>{d.sameInEvery.map(p => <div style="border-top:1px solid var(--line);padding:28px 0;max-width:68ch"><dt><b>{p.title}</b></dt><dd style="margin:12px 0 0;color:var(--muted)">{p.text}</dd></div>)}</dl></div></section>

<section><div class="wrap"><div class="two-col"><div><h2 class="kop-sectie">{d.fitsTitle}</h2><ul>{d.fits.map(f => <li>{f}</li>)}</ul>{d.fitsIntro && <p style="color:var(--muted);margin-top:24px">{d.fitsIntro}</p>}</div><div><h2 class="kop-sectie">Dit past niet als</h2><ul>{d.notFits.map(f => <li>{f}</li>)}</ul></div></div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{d.faqTitle}</h2><div class="faq" style="margin-top:32px">{d.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{d.relatedTitle}</h2><div class="services">{d.relatedPosts.map(p => <a class="svc" href={p.href}>{p.image && <img src={p.image} alt={(p as any).imageAlt ?? ""} width={(p as any).imageWidth ?? 1254} height={(p as any).imageHeight ?? 1254} style="width:100%;border-radius:16px;aspect-ratio:16/9;object-fit:cover" />}<span class="arrow">&nearr;</span><p style="color:var(--muted)">{p.date}</p><h3>{p.title}</h3><p style="color:var(--muted)">{p.description}</p></a>)}</div></div></section>
</Base>

---
import Base from '../layouts/Base.astro';
import { privacy, site } from '../data/content.ts';
const siteUrl = 'https://astro.woodwolfdigital.com';
const jsonLd = [
  { '@type': 'WebPage', '@id': `${siteUrl}/privacy-policy/#webpage`, url: `${siteUrl}/privacy-policy/`, inLanguage: 'en', isPartOf: { '@id': `${siteUrl}/#website` }, name: 'Privacy Policy', publisher: { '@id': `${siteUrl}/#organization` }, breadcrumb: { '@id': `${siteUrl}/privacy-policy/#breadcrumb` } },
  { '@type': 'BreadcrumbList', '@id': `${siteUrl}/privacy-policy/#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Omnimerce', item: `${siteUrl}/` }, { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: `${siteUrl}/privacy-policy/` }] },
];
const email = site.email;
function linkedParts(text: string) {
  return text.split(email);
}
---
<Base title="Privacy Policy · Omnimerce" description={privacy.description} ogDescription="How Omnimerce handles personal information collected through this website, and how to contact us about privacy." jsonLd={jsonLd}>
<section class="legal-hero"><div class="wrap"><div class="leeskolom"><h1>{privacy.title}<span class="text-vivid">.</span></h1><p class="lead">{privacy.lead}</p><p class="legal-links"><a class="textlink" href="/terms/">Terms & Conditions</a></p></div></div></section>
<div class="legal-body">
{privacy.sections.map(s => <section class="legal"><div class="wrap"><h2 class="kop-sectie">{s.heading}</h2><div class="prose">{s.paras.map(p => <p>{linkedParts(p).length > 1 ? linkedParts(p).map((part, i) => i === 0 ? part : <><a href={`mailto:${email}`}>{email}</a>{part}</>) : p}</p>)}</div></div></section>)}
</div>
</Base>

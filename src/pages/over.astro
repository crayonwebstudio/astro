---
import Base from '../layouts/Base.astro';
import { over, site } from '../data/content.ts';
---
<Base title={`${over.title} - ${site.name}`} description={over.lead}>
<section class="hero" style="background:var(--raised)"><div class="wrap"><h1>{over.title}<span class="text-vivid">.</span></h1><div class="over-hero-lead"><p class="over-label">{over.eyebrow}</p><p class="lead" style="max-width:62ch">{over.lead}</p></div></div></section>

<section><div class="wrap"><div class="about-grid">
<figure style="margin:0;position:relative"><div style="border-radius:24px;overflow:hidden;background:var(--raised)"><img src={over.portraitImage} alt={over.portraitAlt} width="1122" height="1402" style="width:100%;aspect-ratio:4/5;object-fit:cover" /></div><a class="linkedin-overlay" href="https://www.linkedin.com/in/dylan-van-den-bosch/" aria-label="Dylan van den Bosch op LinkedIn">in</a><div style="margin-top:28px"><p class="kop-sectie" style="margin:0">{over.founderName}</p><p style="margin-top:8px;color:var(--muted)">{over.founderRole}</p></div></figure>
<div><h2 class="kop-sectie">{over.storyTitle}</h2><div class="prose" style="margin-top:28px">{over.storyBody.map(p => <p set:html={p.replaceAll('waarom', '<strong class="text-vivid">waarom</strong>')} />)}</div><p style="margin-top:22px"><a class="btn" href={site.ctaHref}>{site.ctaLabel} &rarr;</a></p></div>
</div></div></section>

<section><div class="wrap"><div class="pull-right"><h2 class="kop-sectie">{over.pullQuote}.</h2></div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{over.pillarsTitle}</h2><div class="services">{over.pillars.map(p => <div class="svc"><h3>{p.title}</h3><p style="color:var(--muted)">{p.text}</p>{p.linkLabel && <p style="margin-top:14px"><a class="textlink" href={p.linkHref}>{p.linkLabel} &rarr;</a></p>}</div>)}</div></div></section>

<section class="dark-band"><div class="wrap"><div class="two-col"><div><h2 class="kop-sectie">{over.expectationsTitle}</h2><ul>{over.expectations.map(e => <li>{e}</li>)}</ul></div><div><h2 class="kop-sectie">{over.notFitsTitle}</h2><ul>{over.notFits.map(e => <li>{e}</li>)}</ul></div></div></div></section>
</Base>

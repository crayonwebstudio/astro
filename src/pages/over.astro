---
import Base from '../layouts/Base.astro';
import { over, site } from '../data/content.ts';
---
<Base title={`${over.title} - ${site.name}`} description={over.lead}>
<section class="hero"><div class="wrap"><p class="eyebrow">{over.eyebrow}</p><h1>{over.title}</h1><p class="lead">{over.lead}</p></div></section>

<section><div class="wrap"><div class="about-grid">
<figure class="about-img" style="padding:0;overflow:hidden;margin:0"><img src={over.portraitImage} alt={over.portraitAlt} width="1122" height="1402" style="width:100%;height:100%;object-fit:cover;aspect-ratio:4/5" /><figcaption style="margin-top:12px"><b>{over.founderName}</b><br /><span style="color:var(--muted)">{over.founderRole}</span></figcaption></figure>
<div><h2 class="kop-sectie">{over.storyTitle}</h2><div class="prose" style="margin-top:28px">{over.storyBody.map(p => <p>{p}</p>)}</div><p style="margin-top:22px"><a class="btn" href={site.ctaHref}>{site.ctaLabel} &rarr;</a></p></div>
</div></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{over.pullQuote}.</h2></div></section>

<section><div class="wrap"><h2 class="kop-sectie">{over.pillarsTitle}</h2><div class="services">{over.pillars.map(p => <div class="svc"><h3>{p.title}</h3><p style="color:var(--muted)">{p.text}</p>{p.linkLabel && <p style="margin-top:14px"><a class="textlink" href={p.linkHref}>{p.linkLabel} &rarr;</a></p>}</div>)}</div></div></section>

<section><div class="wrap"><div class="two-col"><div><h2 class="kop-sectie">{over.expectationsTitle}</h2><ul>{over.expectations.map(e => <li>{e}</li>)}</ul></div><div><h2 class="kop-sectie">{over.notFitsTitle}</h2><ul>{over.notFits.map(e => <li>{e}</li>)}</ul></div></div></div></section>
</Base>

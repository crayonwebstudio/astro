---
import Base from '../layouts/Base.astro';
import { werkwijze, site } from '../data/content.ts';
---
<Base title={`${werkwijze.title} - ${site.name}`} description={werkwijze.lead}>
<section class="hero"><div class="wrap"><div class="hero-grid"><div><h1>{werkwijze.title}<span class="text-vivid">.</span></h1><p class="lead" style="margin-top:28px">{werkwijze.lead}</p><p style="margin-top:32px"><a class="btn" href={site.ctaHref}>{site.ctaLabel} &rarr;</a> <a class="textlink" href="#fases" style="margin-left:14px">bekijk de vijf fases</a></p></div><nav class="route-nav" aria-label="De vijf fases"><ol>{werkwijze.steps.map(s => <li><a href={`#fase-${s.n}`}><span class="route-nr">{s.n}</span><span>{s.title}</span></a></li>)}</ol></nav></div></div></section>

<section id="fases"><div class="wrap"><ol class="timeline">{werkwijze.steps.map(s => <li class="timeline-step" id={`fase-${s.n}`}><span class="timeline-num">{s.n}</span><div><h2>{s.title}</h2><p>{s.text}</p></div></li>)}</ol></div></section>

<section><div class="wrap"><div class="about-grid">
<figure class="about-img" style="padding:0;overflow:hidden;margin:0;aspect-ratio:3/2"><img src={werkwijze.formsImage} alt={werkwijze.formsImageAlt} width="1942" height="809" style="width:100%;height:100%;object-fit:cover;object-position:88% 50%" /></figure>
<div><h2 class="kop-sectie">{werkwijze.formsTitle}</h2><div class="prose" style="margin-top:28px"><p>{werkwijze.formsIntro}</p></div><div>{werkwijze.forms.map(f => <div style="margin-top:24px"><h3>{f.title}</h3><p style="color:var(--muted)">{f.text}</p></div>)}</div><div class="prose" style="margin-top:28px"><p>{werkwijze.formsClosing}</p></div></div>
</div></div></section>

<section class="dark-band"><div class="wrap"><h2 class="kop-sectie">{werkwijze.selfTitle}</h2><div style="margin-top:28px;max-width:62ch"><p class="dm">{werkwijze.selfIntro}</p></div><div>{werkwijze.selfItems.map(it => <div style="margin-top:28px;max-width:62ch"><h3>{it.title}</h3><p class="dm">{it.text}</p></div>)}</div><p style="margin-top:28px"><a class="textlink" href={werkwijze.selfLinkHref}>{werkwijze.selfLinkLabel} &rarr;</a></p></div></section>

<section><div class="wrap"><h2 class="kop-sectie">Expertise</h2><div class="prose"><p>{werkwijze.expertiseIntro}</p></div><div class="services">{werkwijze.expertiseLinks.map(l => <a class="svc" href={l.href}><span class="arrow">&nearr;</span><h3>{l.n} {l.title}</h3><p style="color:var(--muted)">{l.description}</p></a>)}</div></div></section>
</Base>
